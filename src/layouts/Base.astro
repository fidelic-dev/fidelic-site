---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  wide?: boolean;
  noindex?: boolean;
  /* Set on blog posts: switches og:type to "article", emits article: dates, and adds
     BlogPosting JSON-LD. Without it every post advertised itself as og:type "website",
     which tells a crawler the page is a landing page with no publication date. */
  article?: { date: Date; markdown: string };
  /* Opt-in body class. The homepage sets "theme-dark", which swaps the CSS variables the
     whole site is built on — header, footer, buttons and terminal follow automatically.
     Scoped rather than global because every other page is light, and a redesign of one
     page should not silently restyle the docs. */
  bodyClass?: string;
}
const { title, description, wide = false, noindex = false, article, bodyClass = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/* No author is named anywhere on this site, so the byline is the organisation. Inventing
   a person here would be a fabricated claim in machine-readable form — the worst place
   for one, because nothing downstream re-checks it. */
const jsonLd = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title.replace(/ — Fidelic$/, ''),
  description,
  datePublished: article.date.toISOString(),
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'Fidelic', url: String(Astro.site) },
  isAccessibleForFree: true,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    {article && <meta property="article:published_time" content={article.date.toISOString()} />}
    {/* Point machine readers at the un-chromed source of this page. */}
    {article && <link rel="alternate" type="text/markdown" href={article.markdown} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Fidelic Blog" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {/* Per-page head additions (the homepage loads its two webfonts here). */}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <Header />
    <main class={wide ? 'wrap wrap-wide' : 'wrap'}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
