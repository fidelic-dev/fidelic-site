---
import Base from "../layouts/Base.astro";
// INLINED, NOT <img src>. The graph is one 5 KB file and inlining costs a request rather
// than saving one — but an <img> is opaque to CSS, and the labels have to be addressable:
// at 375px they compute to under 4px and have to be hidden rather than shipped as noise.
import orgGraph from "../../public/org-graph.svg?raw";
// A SECOND LAYOUT FOR PORTRAIT, FROM THE SAME PROGRAM AND THE SAME METADATA — not a
// CSS-scaled copy of the first. A 2:1 drawing in a 375px column is 191px tall: a thin strip
// of specks, which is not "a mid-size Salesforce org" by any reading. The generator takes
// the canvas it is laying out for (-w 720 -h 940), and because gravity is weighted by that
// canvas's aspect the graph RELAXES into portrait rather than being squashed into it. Same
// 39 objects, same 59 relationships; only the arrangement differs.
import orgGraphTall from "../../public/org-graph-tall.svg?raw";
// THE LEGEND'S FIGURES ARE THE DRAWING'S OWN, written by the same run that drew it. A
// legend saying "9 master-detail" beside a picture with eleven of them is worse than no
// legend, and that is exactly what a hand-typed one becomes after the next regeneration.
import graphStats from "../data/org-graph.json";
// THE TRACE STILL, generated by sfemu's scripts/trace-still.mjs from a real captured trace,
// through the same renderer the playground panel and /trace use. Same rule as the org graph:
// generated from real output by a committed program, never drawn.
import traceStill from "../../public/trace-still.svg?raw";
const title =
  "Fidelic: run your Salesforce integration tests without waiting for a sandbox.";
const description =
  "Salesforce integration tests that run on your laptop and in CI — no org, no login, nothing shared. Fidelic is a 10 MB container that loads your real schema and runs your real Apex triggers, so the tests run on every push instead of whenever an environment frees up.";

/* THE TRANSCRIPT, TYPED OUT ONCE.
   Verbatim from a real playground session — the same transcript this page has carried
   since the first version, unchanged. Held as data so the typewriter can reveal it
   without the animation code ever composing a line of its own.

   Each line is a list of SEGMENTS so a single line can carry more than one colour:
     req     the request line        bright, the thing a person typed
     status  an HTTP status code     the green accent, and only ever a status
     pass    an outcome token        the green accent: this is the proof
     out     program output          the terminal's own foreground
     data    a JSON body            cooler and quieter than the request
   `pause` is extra dwell after a line, in ms, where the real session had a round trip. */
const TRANSCRIPT = [
  { segs: [
      { c: "req",  x: "POST /services/data/v62.0/sobjects/DataImportBatch__c" },
      { c: "data", x: ' {"Name":"Spring Appeal"}' },
    ] },
  { segs: [
      { c: "status", x: "201" },
      { c: "data",   x: '  {"id":"a0400000000006zAAA","success":true}' },
    ], pause: 260 },
  { segs: [{ c: "out", x: "" }] },
  { segs: [{ c: "req", x: "GET /__emulator__/fired" }] },
  { segs: [
      { c: "out",  x: "  TDTM_DataImportBatch  before insert  " },
      { c: "pass", x: "entered-clean" },
    ] },
  { segs: [
      { c: "out",  x: "  TDTM_DataImportBatch  after  insert  " },
      { c: "pass", x: "entered-clean" },
    ] },
];
---

<Base title={title} description={description} wide>

  {/* EVERY CLAIM ON THIS PAGE TRACES TO A COMMAND, per the standing rule. The table is here
      so the next person editing this copy can re-run them instead of trusting them:

        the hero graph        → go run ./scripts/orggraph -src <npsp>/force-app
                                -out public/org-graph.svg          (sfemu repo)
                                prints: 39 objects drawn, 20 with triggers,
                                59 relationships (50 lookup, 9 master-detail)
        "boots in seconds"    → the /receipts boot run, NPSP @ 19646faa; the live
                                playground reports warmSeconds 13.9 at /api/health
        "what fired"          → GET /__emulator__/fired, outcome entered-clean
        the transcript        → a real playground session, verbatim
        the analyzer block    → docker run --rm -v ./mdapi:/mdapi:ro --entrypoint /sfapex
                                fidelic/emulator coverage /mdapi — pasted verbatim,
                                including the line saying EXECUTE is not proof it ran
        "75 of 75"            → go run ./cmd/confrun --target=emulator

      EVERY VISUAL IS REAL OUTPUT. No mock Salesforce UI, no screenshot of anyone's product,
      no invented figure, no illustration. The graph is the only non-terminal visual here and
      it is GENERATED FROM NPSP'S OWN METADATA by a committed program, through the same
      loaders the emulator uses — so if the loader stops seeing a relationship, the line
      disappears from the hero too. It is not drawn, and it must never become drawn.

      FINDINGS #18 review: no count of triggers that RUN appears on this page. The analyzer
      block says "classifies EXECUTE" and carries its own disclaimer that this is not proof
      anything ran. */}

  {/* ── PROBLEM: the org, as a graph ──────────────────────────────────────────────────
      One screen: the picture and one line under it. No heading competing with it, because
      the picture IS the heading. */}
  <section class="hero">
    {/* The SVG carries its own <title>/<desc>, generated alongside the drawing, so the
        accessible description cannot drift from the picture the way a hand-written alt
        attribute on an <img> would. */}
    <div class="graph-wrap graph graph-wide" set:html={orgGraph} />
    <div class="graph-wrap graph graph-tall" set:html={orgGraphTall} />
    <p class="graph-caption">
      This is a mid-size Salesforce org. Every line is something a change can break.
    </p>

    {/* THE LEGEND SAYS WHAT THE ENCODING MEANS, and every number in it is generated.
        Without it the picture asks the reader to infer that size means degree and that
        green means something — and the one thing green means on this site is worth
        spelling out rather than leaving to be guessed. */}
    <ul class="legend">
      <li>
        <svg class="sw" viewBox="0 0 34 14" aria-hidden="true">
          <circle cx="7" cy="7" r="2.6" fill="#50505C" /><circle cx="24" cy="7" r="6" fill="#50505C" />
        </svg>
        <span>Each circle is an object — bigger means more relationships, up to
        {graphStats.maxDegree}.<span class="exp"> The biggest are the ones most code
        depends on.</span></span>
      </li>
      <li>
        <svg class="sw" viewBox="0 0 34 14" aria-hidden="true">
          <circle cx="17" cy="7" r="12" fill="#3FB950" opacity=".18" />
          <circle cx="17" cy="7" r="5" fill="#3FB950" />
        </svg>
        <span>Green carries an Apex trigger — {graphStats.withTriggers} of
        {graphStats.objects}.<span class="exp"> Code runs when the record changes.</span></span>
      </li>
      <li>
        <svg class="sw" viewBox="0 0 34 14" aria-hidden="true">
          <line x1="2" y1="7" x2="32" y2="7" stroke="#2A2A31" stroke-width="1" />
        </svg>
        <span>A thin line is a lookup ({graphStats.lookup}).</span>
      </li>
      <li>
        <svg class="sw" viewBox="0 0 34 14" aria-hidden="true">
          <line x1="2" y1="7" x2="32" y2="7" stroke="#3A3A44" stroke-width="1.5" />
        </svg>
        <span>A heavier line is master-detail ({graphStats.masterDetail}).<span class="exp">
        Deleting the parent deletes the child.</span></span>
      </li>
    </ul>

    {/* Reserved height, so selecting an object cannot shift the page under the pointer. */}
    <p class="graph-readout" id="graph-readout" aria-live="polite">
      <span class="hint">
        <span class="on-hover">Point at</span><span class="on-touch">Tap</span>
        any object to see what a change to it would touch.
      </span>
    </p>
  </section>

  {/* ── QUESTIONS: three screens, one question each ───────────────────────────────────
      Large type and nothing else on the screen — no terminal, no caption, no link. These
      are the only things on this site that ask the reader to think about their own org
      rather than about ours, so nothing shares the screen with them. */}
  <section class="question reveal">
    <p>How confident are you that your last change did not break something three objects away?</p>
  </section>

  <section class="question reveal">
    <p>How long do you wait for a sandbox to find out?</p>
  </section>

  <section class="question reveal">
    <p>Can every developer on your team test at the same time?</p>
  </section>

  {/* ── FIDELIC: one paragraph, then the terminal that shows it running ───────────────── */}
  <section class="screen reveal">
    <div class="screen-inner">
      <h2>Fidelic.</h2>
      <p class="answer lead">
        It boots that org on your laptop in seconds. Your tests run against it the way they
        run against a real org, and every request can tell you exactly what fired. No
        sandbox, no queue, no shared data.
      </p>

      <div
        class="terminal hero-term"
        role="img"
        aria-label="Playground transcript: a POST creating a DataImportBatch record returns HTTP 201, and GET /__emulator__/fired then shows TDTM_DataImportBatch running on both before-insert and after-insert with the outcome entered-clean."
      >
        <pre id="tape" data-tape={JSON.stringify(TRANSCRIPT)}></pre>
      </div>
      <p class="hero-caption" id="caption">A real NPSP trigger ran before the record saved.</p>
    </div>
  </section>

  {/* ── PROOF: one request, shown ────────────────────────────────────────────────────
      THE FOUR LABELS ARE GONE FROM HERE. They were the analyzer's vocabulary — EXECUTE,
      HOOKS, RECORDED-ONLY, UNRESOLVED — explained on the page a reader meets before they
      have any reason to care which word applies to their trigger. The vocabulary still
      exists and /capabilities still defines it; what belongs on the front page is the thing
      that makes the words unnecessary: a real request, opened up, showing what ran and what
      it changed.

      The graph above says a change can break something three objects away. This says what
      that looks like one request deep, on the SAME NPSP org, so the two pictures are about
      one thing rather than two. */}
  <section class="screen reveal" id="trace-still">
    <div class="screen-inner">
      <h2>One request, from the inside.</h2>
      <p class="answer">
        A record is created. NPSP's own handler sets the batch status, and a second handler —
        staged for this picture — closes it again in the after-insert phase. The trace shows
        both writes, which trigger made each, and that the second one won.
      </p>
      <div class="trace-wrap" set:html={traceStill} />
      <p class="src">
        Real output, not a diagram: captured from <code>GET /__emulator__/trace</code> and
        rendered by the same code that draws the panel in the playground.
        <a href="/trace">Paste your own trace →</a> ·
        <a href="/capabilities">See exactly what we support</a>
      </p>
      <p class="src">
        Every number and every picture on this page comes from a command you can run
        yourself — the graph from NPSP's own object metadata, this trace from a real request,
        neither of them drawn. The conformance suite is public and is the same one we gate
        on: <code>go run ./cmd/confrun --target=emulator</code> reports
        <span class="pass">75/75 PASS</span>.
        <a href="/receipts">Every number, and the command that produced it</a>.
      </p>
    </div>
  </section>

  {/* ── ASK ───────────────────────────────────────────────────────────────────────────── */}
  <section class="screen reveal" id="waitlist">
    <div class="screen-inner">
      <div class="waitlist">
        <h2>Want to try it on your org? Email me.</h2>
        <form action="https://formspree.io/f/mkodpozp" method="POST">
          <input
            type="email"
            name="email"
            placeholder="you@company.com"
            aria-label="Email address"
            required
          />
          <input type="hidden" name="_subject" value="Email me" />
          <input type="hidden" name="_next" value="https://www.fidelic.dev/thanks" />
          <button class="btn" type="submit">Email me</button>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── HOMEPAGE: ONE CLAIM PER SCREEN ────────────────────────────────────────────────
     Colour lives in global.css. This file is layout, type scale and motion.

     svh, not vh. On a phone `100vh` is the viewport with the browser chrome RETRACTED, so
     a 100vh hero is taller than what you can actually see and the next section peeks in
     underneath — which is precisely the "nothing else visible" rule broken. svh is the
     small viewport: chrome shown, nothing peeking. */

  /* HERO. The graph and one line. No heading, no button, no scroll hint. */
  .hero {
    min-height: calc(100svh - var(--header-h, 61px));
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: clamp(0.85rem, 2svh, 1.5rem);
    text-align: center;
    padding: 4svh 0;
    box-sizing: border-box;
  }
  .graph-wrap { width: 100%; min-height: 0; display: flex; justify-content: center; }
  /* ONE OF THE TWO IS ALWAYS DISPLAY:NONE, never both. They are the same org drawn for two
     canvas shapes; showing both would say there are two graphs. */
  .graph-tall { display: none; }
  .graph :global(svg) {
    width: 100%;
    height: auto;
    /* The graph must never push the caption off the screen: it is the hero's flexible
       part and the caption is the fixed one, so the picture gives way first. */
    max-height: 58svh;
    object-fit: contain;
    /* A SUBTLE FADE AND NOTHING ELSE. No pan, no draw-on, no parallax — the picture is
       evidence, and animating evidence into place makes it look staged. */
    animation: graph-in 760ms ease-out both;
  }
  @keyframes graph-in { from { opacity: 0; } to { opacity: 1; } }

  .graph-caption {
    margin: 0;
    color: var(--muted);
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    max-width: 52ch;
    text-wrap: balance;
    animation: graph-in 760ms ease-out 240ms both;
  }

  /* ── LEGEND ────────────────────────────────────────────────────────────────────────
     A row on wide screens, a column on narrow ones. The swatches are inline SVG using the
     literal colours and widths the generator emits, so a palette change that misses one of
     them is visible rather than subtle. */
  /* A GRID, NOT A WRAPPING ROW. Flex-wrap flowed the four items into a ragged three-row
     shape — two on the first row, one stranded beside the third — which reads as a layout
     accident rather than a key. Two fixed columns keep the swatches aligned down the left
     and every item on its own line. */
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    justify-content: center;
    gap: 0.5rem 2rem;
    max-width: 74ch;
    text-align: left;
    animation: graph-in 760ms ease-out 360ms both;
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.86rem;
    text-align: left;
  }
  .legend .sw { width: 34px; height: 14px; flex: none; overflow: visible; }

  /* The readout. Height is reserved for one line so selecting an object cannot shift the
     page under the pointer that selected it. */
  .graph-readout {
    margin: 0;
    min-height: 1.4em;
    font-size: 0.88rem;
    color: var(--muted);
    animation: graph-in 760ms ease-out 480ms both;
  }
  .graph-readout .hint { opacity: 0.72; }
  /* The explanatory half of each legend line. Dropped on phones, where four two-line items
     pushed the last one below the fold — but only the PROSE goes; every generated figure
     stays, because those are the numbers the legend exists to state. */
  @media (max-width: 640px) { .exp { display: none; } }
  .graph-readout .name { color: var(--fg); font-family: var(--mono); }
  .graph-readout .trig { color: var(--accent); }
  /* "Point at" or "Tap", decided by whether the device actually has a pointer rather than
     by guessing from width — a touch laptop is both wide and untappable-at. */
  .on-touch { display: none; }
  @media (hover: none) {
    .on-hover { display: none; }
    .on-touch { display: inline; }
  }

  /* The graph is a control now, so it takes focus; the ring is the page's foreground
     colour and sits outside the drawing. */
  .graph :global(svg:focus-visible) {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
    border-radius: 6px;
  }

  /* The trace still. Scrolls sideways in its own box rather than scaling to nothing — the
     viewBox is 1180 wide and a 375px phone would render 13px type at 4px. Contained, so a
     sideways flick never drags the page. */
  .trace-wrap {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-bottom: 0.9rem;
  }
  .trace-wrap :global(svg) { display: block; min-width: 980px; width: 100%; height: auto; }
  @media (min-width: 1060px) { .trace-wrap :global(svg) { min-width: 0; } }

  /* ── THE THREE QUESTIONS ───────────────────────────────────────────────────────────
     One per screen, centred, and ALONE. The largest type on the site, because a question
     the reader is meant to answer for themselves should not be sized like body copy
     sitting under a heading. */
  .question {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6svh 0;
    box-sizing: border-box;
    border-top: 1px solid var(--border);
  }
  .question p {
    margin: 0;
    font-size: clamp(1.75rem, 4.6vw, 3.1rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 600;
    max-width: 18ch;
    text-wrap: balance;
  }

  /* ── SCROLL SECTIONS: one claim, one screen ──────────────────────────────────────── */
  .screen {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 4svh 0;
    box-sizing: border-box;
    border-top: 1px solid var(--border);
  }
  .screen-inner { width: 100%; }
  .screen h2 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 0 0 1.1rem;
    max-width: 34ch;
  }
  .screen .answer { max-width: 60ch; margin: 0 0 1.8rem; font-size: 1.05rem; }
  /* The one-paragraph definition carries a little more weight than the copy around it —
     it is the only paragraph on the page that says what this product is. */
  .screen .answer.lead { font-size: clamp(1.1rem, 1.7vw, 1.3rem); line-height: 1.55; }
  .screen .terminal { font-size: clamp(0.72rem, 0.95vw, 0.9rem); line-height: 1.6; }

  /* THE ANALYZER BLOCK WRAPS; THE TRANSCRIPT DOES NOT.
     Those are long single lines — a ladder line whose counts sit at column 150 — and left
     to scroll they hid exactly the part that is the proof. Wrapping costs nothing there
     because none of that output is aligned in columns, unlike the transcript, where
     `entered-clean` lining up under itself IS the thing being shown. Continuations are
     indented, so a wrapped entry still reads as one entry. */
  .screen .terminal:not(.hero-term) pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding-left: 2ch;
    text-indent: -2ch;
  }

  /* The transcript keeps its columns and scrolls sideways inside its own box rather than
     wrapping into nonsense. Contained, so a sideways flick never drags the page. */
  .hero-term {
    text-align: left;
    width: 100%;
    padding: clamp(1.1rem, 2.2vw, 1.6rem);
    font-size: clamp(0.76rem, 1.1vw, 1rem);
    line-height: 1.65;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }
  /* Height reserved for the finished tape so arriving lines cannot shift the page under
     the reader. Six lines. */
  .hero-term pre { min-height: calc(6 * 1.65em); margin: 0; }

  /* The caption is the last thing to arrive and the quietest thing on the screen. */
  .hero-caption {
    margin: 0.9rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    opacity: 0;
    transition: opacity 420ms ease-out;
  }
  .hero-caption.shown { opacity: 1; }

  /* The caret exists only while typing, and is removed when the tape finishes so a
     finished transcript does not sit there blinking at nothing. */
  .hero-term .caret {
    display: inline-block;
    width: 0.55em;
    background: var(--accent);
    color: var(--accent);
    animation: blink 1s steps(2, start) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .screen .src {
    margin: 0.9rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    max-width: 66ch;
  }
  .screen .src code { color: var(--fg); font-size: 0.95em; }

  /* The one surface on the page, so it states all four sides of its own padding rather
     than inheriting a section rule that zeroes the horizontal half. */
  .waitlist {
    padding: 2.5rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--term-bg);
    max-width: 40rem;
  }
  .waitlist h2 { margin-top: 0; }

  /* ── MOTION ────────────────────────────────────────────────────────────────────────
     Fade and rise: 14px of travel, 320ms. Enough to read as deliberate, short enough that
     scrolling never waits for it. */
  .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 320ms ease-out, transform 320ms ease-out;
  }
  .reveal.shown { opacity: 1; transform: none; }

  /* IF MOTION IS UNWELCOME, THERE IS NO MOTION — not a faster version of it. Sections are
     simply present, the graph is already there rather than fading in, the terminal is
     handed over fully typed, and the caption is not waiting behind an animation that will
     never run. */
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    .graph :global(svg), .graph-caption { animation: none; }
    .hero-caption { opacity: 1; transition: none; }
    .hero-term .caret { animation: none; }
  }

  /* SHORT WINDOWS. The hero is a fixed budget — one screen — and a picture sized only to
     WIDTH overspends it: on a 1280x720 laptop a full-width graph is 589px tall before the
     caption gets a line. Height is the constraint here, so height drives the scale. */
  @media (max-height: 820px) and (min-width: 641px) {
    .hero { padding: 3svh 0; }
    .graph :global(svg) { max-height: 50svh; }
    .question p { font-size: clamp(1.6rem, 3.6vw, 2.4rem); }
  }

  @media (max-width: 640px) {
    /* THE LEGEND COSTS 192px STACKED, which is what pushed the hero 21px past the
       viewport. The space comes out of the hero's own padding and gaps before it comes out
       of the drawing: the legend is what makes the drawing readable, so shrinking the
       drawing to fit the legend would be paying twice. */
    .hero { padding: 2svh 0; gap: 0.7rem; }
    /* ON A PHONE THE GRAPH IS THE WHOLE POINT AND WIDTH IS THE PROBLEM. A 2:1 drawing in a
       343px column is 175px tall — a smear with unreadable labels. Bleeding to the full
       viewport width buys back the page gutters, and the taller cap gives it room to be
       looked at rather than glanced past. */
    .graph-wrap {
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
    }
    .graph-wide { display: none; }
    .graph-tall { display: flex; }
    .graph :global(svg) { max-height: 41svh; }
    /* LABELS OFF ON A PHONE. The viewBox is 1154 wide, so at 375px the 11-unit type
       renders under 4 CSS px: not small, ILLEGIBLE — it reads as speckle and makes the
       drawing look like a rendering artefact. The names are not lost, they are in the
       SVG's own <desc>, which is what a screen reader gets either way. Structure is what
       survives at this width, and structure is what the caption is about. */
    .graph :global(text) { display: none; }
    .graph-caption { font-size: 0.95rem; padding: 0 0.25rem; }
    /* STACKED ON A PHONE. Four legend items side by side at 375px wrap mid-sentence and
       read as eight fragments; one per row keeps each swatch beside the words it explains. */
    .legend { grid-template-columns: 1fr; gap: 0.4rem; padding: 0 0.25rem; }
    .legend li { font-size: 0.82rem; }
    .graph-readout { font-size: 0.84rem; padding: 0 0.25rem; }
    .question { padding: 8svh 0; }
    .question p { font-size: clamp(1.5rem, 7.2vw, 2rem); max-width: 16ch; }
    .screen { padding: 6svh 0; }
    .screen .answer { font-size: 1rem; }
    .screen .answer.lead { font-size: 1.08rem; }
    .hero-term { padding: 1rem 0.9rem; line-height: 1.6; }
    .hero-term pre { min-height: calc(6 * 1.6em); }
    .hero-caption { font-size: 0.88rem; }
    .waitlist { padding: 1.5rem; }
  }
  /* THE SMALL-PHONE CASE, measured rather than assumed. A 360x640 Android has 7px less
     than the hero needs once the legend is stacked; taking it out of the drawing for every
     phone would be paying for one device with all of them. This rule fires only where the
     shortfall exists.

     PLACED AFTER the max-width block on purpose: same specificity, so source order
     decides, and sitting above it this was simply overridden and did nothing. */
  @media (max-width: 640px) and (max-height: 660px) {
    .hero { gap: 0.55rem; padding: 1.5svh 0; }
    .graph :global(svg) { max-height: 36svh; }
    .graph-caption { font-size: 0.9rem; }
    .legend li { font-size: 0.78rem; }
  }

</style>

<script>
  /* Hand-written, no library. Three jobs: type the transcript once, show the caption when
     it finishes, reveal sections as they arrive. All three check prefers-reduced-motion
     first and degrade to "already done". */
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // --- the tape -----------------------------------------------------------------------
  const tape = document.getElementById("tape");
  const caption = document.getElementById("caption");
  const showCaption = () => { if (caption) caption.classList.add("shown"); };

  if (tape) {
    const lines = JSON.parse(tape.dataset.tape || "[]");
    const el = (cls, text) => {
      const e = document.createElement("span");
      if (cls) e.className = cls;
      e.textContent = text;
      return e;
    };
    // The finished state, which reduced-motion gets immediately and the animation
    // converges on. One function, so the two paths cannot drift apart. `partial` is a
    // character count into the line being typed; segments are emitted in order and
    // clipped against it, so a half-typed line keeps every colour it will end up with.
    const paint = (upto, partial) => {
      tape.textContent = "";
      for (let i = 0; i <= upto && i < lines.length; i++) {
        const segs = lines[i].segs || [];
        let budget = i === upto && partial !== undefined ? partial : Infinity;
        for (const s of segs) {
          if (budget <= 0) break;
          const text = s.x.length <= budget ? s.x : s.x.slice(0, budget);
          if (text) tape.appendChild(el(s.c, text));
          budget -= s.x.length;
        }
        // No newline after the final painted line: a trailing one leaves a blank row
        // inside a box whose height is already reserved.
        if (i < upto) tape.appendChild(document.createTextNode("\n"));
      }
    };
    const lineLen = (l) => (l.segs || []).reduce((n, s) => n + s.x.length, 0);

    const type = () => {
      let li = 0, ci = 0;
      const caret = el("caret", " ");
      const step = () => {
        if (li >= lines.length) {
          caret.remove();            // finished: stop blinking, and do not loop
          paint(lines.length - 1);
          showCaption();
          return;
        }
        const len = lineLen(lines[li]);
        ci += 1;
        paint(li, ci);
        tape.appendChild(caret);
        if (ci >= len) {
          li += 1; ci = 0;
          setTimeout(step, lines[li - 1].pause || 90);
        } else {
          // 6ms/char: the whole tape lands in about 1.7s, which reads as typing without
          // making anyone wait to see the 201.
          setTimeout(step, 6);
        }
      };
      step();
    };

    if (reduce || !("IntersectionObserver" in window)) {
      paint(lines.length - 1);
      showCaption();
    } else {
      // TYPE ON ARRIVAL, NOT ON LOAD. The terminal used to be the hero and could safely
      // start typing immediately. It now sits four screens down, where typing on load
      // means the animation plays to an empty room and the reader arrives at a finished
      // transcript — the one thing a typewriter is supposed to avoid. Once only,
      // unobserved on first intersection: a transcript that retypes every time it scrolls
      // past is a toy.
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          type();
        });
      }, { threshold: 0.35 });
      io.observe(tape);
    }
  } else {
    showCaption();
  }

  // --- the org graph: point at an object, see what it touches ------------------------
  //
  // The caption says every line is something a change can break. This makes that operable:
  // selecting an object lights its relationships and the objects on the other end of them,
  // and fades the rest. Everything it needs is already in the SVG — the generator emits a
  // hit target per object carrying the name, the degree and whether it has a trigger — so
  // the page never holds a second copy of the graph that could disagree with the drawing.
  const readout = document.getElementById("graph-readout");
  const hintHTML = readout ? readout.innerHTML : "";

  document.querySelectorAll(".graph svg").forEach((svg) => {
    const hits = [...svg.querySelectorAll(".hit")];
    if (!hits.length) return;
    const lines = [...svg.querySelectorAll("line.e")];
    const nodes = [...svg.querySelectorAll("circle.n")];
    const halos = [...svg.querySelectorAll("circle.halo")];
    const labels = [...svg.querySelectorAll("text.lbl")];
    const byIndex = (list) => {
      const m = new Map();
      list.forEach((el) => {
        const i = el.dataset.i;
        if (!m.has(i)) m.set(i, []);
        m.get(i).push(el);
      });
      return m;
    };
    const nodeEls = byIndex(nodes), haloEls = byIndex(halos), labelEls = byIndex(labels);

    // Adjacency comes from the drawn lines, not from a parallel data structure. If an edge
    // is not drawn it cannot light up, which is the correct behaviour rather than a bug.
    const near = new Map();
    lines.forEach((l) => {
      const { a, b } = l.dataset;
      if (!near.has(a)) near.set(a, new Set());
      if (!near.has(b)) near.set(b, new Set());
      near.get(a).add(b);
      near.get(b).add(a);
    });

    let pinned = null;   // set by click/tap, so a touch selection survives the finger lifting
    let current = null;

    const clear = () => {
      svg.classList.remove("sel");
      [...lines, ...nodes, ...halos, ...labels].forEach((el) =>
        el.classList.remove("on", "near"));
      current = null;
      if (readout) readout.innerHTML = hintHTML;
    };

    const mark = (list, i, cls) => (list.get(String(i)) || []).forEach((el) =>
      el.classList.add(cls));

    const select = (i) => {
      if (current === String(i)) return;
      clear();
      current = String(i);
      svg.classList.add("sel");
      mark(nodeEls, i, "on"); mark(haloEls, i, "on"); mark(labelEls, i, "on");
      (near.get(current) || new Set()).forEach((j) => {
        mark(nodeEls, j, "near"); mark(haloEls, j, "near"); mark(labelEls, j, "near");
      });
      lines.forEach((l) => {
        if (l.dataset.a === current || l.dataset.b === current) l.classList.add("on");
      });
      const hit = hits.find((h) => h.dataset.i === current);
      if (readout && hit) {
        const deg = Number(hit.dataset.deg);
        const name = hit.dataset.name;
        // textContent for the name, which comes from customer metadata and is never
        // trusted as markup. The rest is ours.
        const el = document.createElement("span");
        el.className = "name";
        el.textContent = name;
        readout.textContent = "";
        readout.append(el, ` — ${deg} relationship${deg === 1 ? "" : "s"}`);
        if (hit.dataset.t === "1") {
          const t = document.createElement("span");
          t.className = "trig";
          t.textContent = " · carries an Apex trigger";
          readout.append(t);
        }
      }
    };

    hits.forEach((hit) => {
      hit.addEventListener("pointerenter", () => { if (!pinned) select(hit.dataset.i); });
      hit.addEventListener("pointerleave", () => { if (!pinned) clear(); });
      // TAP PINS. On a phone there is no hover and pointerleave may never arrive, so a tap
      // that only previewed would clear itself the moment the finger lifted. Tapping the
      // same object again releases it.
      hit.addEventListener("click", (ev) => {
        ev.stopPropagation();
        if (pinned === hit.dataset.i) { pinned = null; clear(); return; }
        pinned = hit.dataset.i;
        select(hit.dataset.i);
      });
    });

    // ONE TAB STOP FOR THE WHOLE GRAPH, not thirty-nine.
    //
    // Making every dot focusable is the obvious move and it buries the rest of the page
    // behind 39 tab presses. The graph takes focus once and arrow keys walk it, which is
    // the roving pattern a listbox uses. Objects are walked in the order the legend
    // explains — most relationships first — so the first thing a keyboard reaches is the
    // hub, not whichever node the layout happened to emit first.
    const order = hits
      .map((h) => h.dataset.i)
      .sort((x, y) => {
        const hx = hits.find((h) => h.dataset.i === x), hy = hits.find((h) => h.dataset.i === y);
        return Number(hy.dataset.deg) - Number(hx.dataset.deg) ||
          hx.dataset.name.localeCompare(hy.dataset.name);
      });
    let cursor = -1;
    svg.setAttribute("tabindex", "0");
    svg.addEventListener("keydown", (ev) => {
      const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[ev.key];
      if (step) {
        ev.preventDefault();
        cursor = (cursor + step + order.length) % order.length;
        pinned = order[cursor];
        select(pinned);
      } else if (ev.key === "Escape") {
        cursor = -1; pinned = null; clear();
      }
    });
    svg.addEventListener("blur", () => { if (pinned !== null && cursor >= 0) { cursor = -1; pinned = null; clear(); } });

    // Clicking the background releases a pinned selection.
    svg.addEventListener("click", () => { if (pinned) { pinned = null; clear(); } });
  });

  // --- section reveals ----------------------------------------------------------------
  const bands = document.querySelectorAll(".reveal");
  if (reduce || !("IntersectionObserver" in window)) {
    bands.forEach((b) => b.classList.add("shown"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("shown");
            io.unobserve(e.target);   // reveal once; never re-animate on scroll back
          }
        });
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
    );
    bands.forEach((b) => io.observe(b));
  }
</script>
