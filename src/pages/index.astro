---
import Base from "../layouts/Base.astro";
const title =
  "Fidelic: run your Salesforce integration tests without waiting for a sandbox.";
const description =
  "Salesforce integration tests that run on your laptop and in CI — no org, no login, nothing shared. Fidelic is a 10 MB container that loads your real schema and runs your real Apex triggers, so the tests run on every push instead of whenever an environment frees up.";

/* THE HERO TRANSCRIPT, TYPED OUT ON LOAD.
   Verbatim from a real playground session — the same transcript that was already on this
   page, unchanged. Held as data so the typewriter can reveal it line by line without the
   animation code ever composing a line of its own.

   `t` is the token class: "" plain, "cmd" the request line, "ok" the green pass lines,
   "dim" the payloads. `pause` is extra dwell after a line, in ms, used where a real
   session had a round trip. */
const TRANSCRIPT = [
  { t: "cmd", s: "POST /services/data/v62.0/sobjects/DataImportBatch__c", tail: ' {"Name":"Spring Appeal"}' },
  { t: "ok",  s: "201", tail: '  {"id":"a0400000000006zAAA","success":true}', pause: 240 },
  { t: "",    s: "" },
  { t: "cmd", s: "GET /__emulator__/fired" },
  { t: "ok",  s: "  TDTM_DataImportBatch", tail: "  before insert  entered-clean" },
  { t: "ok",  s: "  TDTM_DataImportBatch", tail: "  after  insert  entered-clean" },
];
---

<Base title={title} description={description} bodyClass="theme-dark">
  {/* Two faces, both from Google Fonts: Inter for headings and body, JetBrains Mono for
      every terminal and code run. Loaded here rather than globally — the light pages keep
      the system stack they already shipped with. */}
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;620;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </Fragment>

  {/* EVERY CLAIM ON THIS PAGE TRACES TO A COMMAND, per the standing rule. The table is here
      so the next person editing this copy can re-run them instead of trusting them:

        "without waiting for a sandbox"  → docs/ci/github-actions.md; real workflow run
                                           35263998942, 16s, 4/4 tests, no org involved
        "10 MB"                          → hub.docker.com/r/fidelic/emulator, 10.34 MB compressed
        "row locks, rate limits"         → POST /__emulator__/faults; conformance faults-001..005
        "your real Apex triggers"        → GET /__emulator__/fired, outcome entered-clean
        "75 of 75"                       → go run ./cmd/confrun --target=emulator
        the hero transcript              → a real playground session, verbatim

      FINDINGS #18 review: no count of triggers that RUN appears on this page. The only
      trigger count is in the playground line, which says "loaded and classified". */}
  <section class="hero">
    <h1>Run your Salesforce integration tests without waiting for a sandbox.</h1>
    <p class="hero-sub">
      A 10 MB container that answers on <code>localhost</code> like your org does.
    </p>

    <div
      class="terminal hero-term"
      role="img"
      aria-label="Playground transcript: creating a DataImportBatch record returns HTTP 201, and the fired-trigger log shows TDTM_DataImportBatch running on both before-insert and after-insert."
    >
      <pre id="tape" data-tape={JSON.stringify(TRANSCRIPT)}></pre>
    </div>

    <p class="hero-cta">
      <a class="btn" href="https://play.fidelic.dev">Open the playground →</a>
    </p>
  </section>

  <section class="band reveal">
    <h2>Sandboxes are scarce and shared.</h2>
    <p class="answer">
      Tests queue for an environment, then fail because someone else changed the data
      underneath them. The hardest and most valuable tests are the ones that get skipped,
      because the environment is never free when you need it.
    </p>
  </section>

  <section class="band reveal">
    <h2>It runs your org on your own machine.</h2>
    <p class="answer">
      Fidelic loads your org's real schema and runs your real Apex triggers. Your tests point
      at <code>localhost</code> and get the same REST responses, the same trigger side
      effects, the same validation errors. These are the responses a real org would return.
    </p>
  </section>

  <section class="band reveal">
    <h2>Every trigger gets one of four labels.</h2>
    <ul class="answer-list">
      <li>
        <strong>EXECUTE</strong>: nothing in the reachable code is unsupported, so the
        interpreter will run your real Apex.
      </li>
      <li>
        <strong>HOOKS</strong>: the effect is reproduced by a rule instead of by running
        the Apex.
      </li>
      <li>
        <strong>RECORDED-ONLY</strong>: the code could run, but the thing that starts it
        cannot happen on your machine, a platform event for instance.
      </li>
      <li>
        <strong>UNRESOLVED</strong>: refused, with the file name, line number, and the
        construct it uses that we do not support.
      </li>
    </ul>
    <p class="answer">
      <a href="/capabilities#vocabulary">See exactly what we support</a>
    </p>
  </section>

  <section class="band reveal">
    <h2>It can fail on purpose.</h2>
    <p class="answer">
      One call creates a row lock, a rate limit, or slow responses, and the next request
      returns the real Salesforce error. You cannot make a sandbox do that.
      <a href="/capabilities">See the full list of capabilities</a>.
    </p>
  </section>

  <section class="band reveal">
    <h2>It runs in CI.</h2>
    <p class="answer">
      <a href="/docs/ci-github-actions">The CI recipe</a> — a GitHub Actions workflow you can
      copy, that boots the org, runs your tests, and tears down.
    </p>
  </section>

  <section class="band reveal receipts">
    <p>
      Every number on this page comes from a command. <a href="/receipts">Run them yourself</a>.
    </p>
    <p>
      Passes the public conformance suite, 75 of 75 · 5 skipped, 3 pending.
      <a href="https://github.com/fidelic-dev/fidelic-conformance">Run the scorecard yourself →</a>
    </p>
  </section>

  <section class="band reveal waitlist" id="waitlist">
    <h2>Want to try it on your org?</h2>
    <p>Email me.</p>
    <form action="https://formspree.io/f/mkodpozp" method="POST">
      <input
        type="email"
        name="email"
        placeholder="you@company.com"
        aria-label="Email address"
        required
      />
      <input type="hidden" name="_subject" value="Email me" />
      <input type="hidden" name="_next" value="https://www.fidelic.dev/thanks" />
      <button class="btn" type="submit">Email me</button>
    </form>
  </section>
</Base>

<style>
  /* ── HOMEPAGE LAYOUT ───────────────────────────────────────────────────────────────
     Colour lives in the scoped dark palette in global.css. This file is spacing, type
     scale and motion only. */
  :global(body.theme-dark) {
    font-family: "Inter", var(--font);
  }
  /* `pre` and `code` carry a UA font-family, which beats inheritance — so the mono face
     has to be named on the elements themselves, not only on their container. */
  :global(body.theme-dark .terminal),
  :global(body.theme-dark .terminal pre),
  :global(body.theme-dark pre),
  :global(body.theme-dark code) {
    font-family: "JetBrains Mono", var(--mono);
  }

  /* THE FIRST VIEWPORT HAS TO CARRY THE OUTCOME: headline, one line, a real call with a
     real result. So the hero is sized to fit rather than to impress — the padding is
     deliberately modest at the bottom, because the terminal matters more than the air
     around it. */
  .hero {
    text-align: center;
    padding: 3.2rem 0 1rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 5.2vw, 3.3rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 700;
    max-width: 22ch;
    margin: 0 auto 1rem;
  }
  .hero-sub {
    color: var(--muted);
    font-size: 1.1rem;
    max-width: 46ch;
    margin: 0 auto 2.2rem;
  }
  .hero-sub code { font-size: 0.95em; color: var(--fg); }
  .hero-term { text-align: left; margin: 0 auto; max-width: 100%; }
  /* Height reserved for the tallest state so the typing animation cannot shift the page
     under the reader as lines arrive. Six transcript lines plus padding. */
  .hero-term pre { min-height: calc(6 * 1.65em); margin: 0; }
  .hero-cta { margin: 2rem 0 0; }

  /* The caret only exists while typing; it is removed when the tape finishes so a
     finished transcript does not sit there blinking at nothing. */
  .hero-term .caret {
    display: inline-block;
    width: 0.55em;
    background: var(--accent);
    color: var(--accent);
    animation: blink 1s steps(2, start) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  /* GENEROUS, AND EVEN. The old page ran sections together at 2.6rem; these are set once
     here so the rhythm cannot drift section by section. */
  .band { padding: 3.4rem 0; border-top: 1px solid var(--border); }
  .band:first-of-type { border-top: 0; }
  .band h2 {
    font-size: 1.45rem;
    letter-spacing: -0.02em;
    margin: 0 0 0.9rem;
  }
  .band .answer { max-width: 62ch; margin-bottom: 0; }
  .band .answer + .answer { margin-top: 1.1rem; }
  .band .answer-list { margin: 0 0 1.2rem; }

  .band.receipts {
    border-left: 0;
    padding-left: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  /* THE CARD NEEDS ITS OWN PADDING, all four sides. `.band` sets `padding: 3.4rem 0`,
     which zeroed the horizontal padding the card inherited — so it kept its fill and its
     border while the heading sat flush on the left edge and, at 375px, the input touched
     the right one. Stated explicitly here rather than relying on the band rule, because
     this is the one band that is a surface rather than a stripe. */
  .band.waitlist {
    margin: 3.4rem 0 0;
    padding: 2.5rem;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .band.waitlist h2 { margin-top: 0; }

  /* ── MOTION ────────────────────────────────────────────────────────────────────────
     Fade and rise, fast. 14px of travel and 320ms: enough to read as deliberate, short
     enough that scrolling never waits for it. No bounce, no parallax, no transforms that
     keep running after arrival. */
  .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 320ms ease-out, transform 320ms ease-out;
  }
  .reveal.shown { opacity: 1; transform: none; }

  /* IF MOTION IS UNWELCOME, THERE IS NO MOTION — not a faster version of it. Sections are
     simply present, and the terminal is handed over fully typed by the script. */
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    .hero-term .caret { animation: none; }
  }

  @media (max-width: 640px) {
    .hero { padding: 2rem 0 0.5rem; }
    .hero h1 { font-size: clamp(1.75rem, 8.5vw, 2.3rem); max-width: 18ch; }
    .hero-sub { font-size: 1rem; margin-bottom: 1.6rem; }
    .band { padding: 2.6rem 0; }
    .band.waitlist { padding: 1.5rem; margin-top: 2.6rem; }
    /* The transcript holds its columns — the alignment of `entered-clean` under itself is
       the thing being shown — so it scrolls sideways inside its own box rather than
       wrapping into nonsense. Contained, so a sideways flick does not drag the page. */
    .hero-term { overflow-x: auto; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; }
    .hero-term pre { min-height: calc(6 * 1.6em); }
  }
</style>

<script>
  /* Hand-written, no library. Two jobs: type the transcript once, and reveal sections as
     they arrive. Both check prefers-reduced-motion first and degrade to "already done". */
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // --- the tape -----------------------------------------------------------------------
  const tape = document.getElementById("tape");
  if (tape) {
    const lines = JSON.parse(tape.dataset.tape || "[]");
    const span = (cls, text) => {
      const e = document.createElement("span");
      if (cls) e.className = cls;
      e.textContent = text;
      return e;
    };
    // The finished state, which reduced-motion gets immediately and the animation
    // converges on. One function so the two paths cannot drift apart.
    const paint = (upto, partial) => {
      tape.textContent = "";
      for (let i = 0; i <= upto && i < lines.length; i++) {
        const l = lines[i];
        const text = i === upto && partial !== undefined ? partial : l.s + (l.tail || "");
        // Each line is at most two spans: the token-coloured head, then the dim payload.
        const headLen = Math.min(text.length, l.s.length);
        if (headLen > 0) tape.appendChild(span(l.t, text.slice(0, headLen)));
        if (text.length > l.s.length) tape.appendChild(span("dim", text.slice(l.s.length)));
        // No newline after the final line: a trailing one leaves a blank row under the
        // transcript, inside a box whose height is already reserved.
        if (i < upto) tape.appendChild(document.createTextNode("\n"));
      }
    };

    if (reduce) {
      paint(lines.length - 1);
    } else {
      let li = 0, ci = 0;
      const caret = span("caret", " ");
      const step = () => {
        if (li >= lines.length) {
          caret.remove();           // finished: stop blinking, do not loop
          paint(lines.length - 1);
          return;
        }
        const full = lines[li].s + (lines[li].tail || "");
        ci += 1;
        paint(li, full.slice(0, ci));
        tape.appendChild(caret);
        if (ci >= full.length) {
          li += 1; ci = 0;
          setTimeout(step, lines[li - 1].pause || 90);
        } else {
          // 6ms/char. The whole tape lands in about 1.7s, which reads as typing without
          // making anyone wait to see the 201.
          setTimeout(step, 6);
        }
      };
      step();
    }
  }

  // --- section reveals ----------------------------------------------------------------
  const bands = document.querySelectorAll(".reveal");
  if (reduce || !("IntersectionObserver" in window)) {
    bands.forEach((b) => b.classList.add("shown"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("shown");
            io.unobserve(e.target);   // reveal once; never re-animate on scroll back
          }
        });
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
    );
    bands.forEach((b) => io.observe(b));
  }
</script>
