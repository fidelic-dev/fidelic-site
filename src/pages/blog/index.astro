---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const title = 'Fidelic Blog';
const description = 'Notes on building a conformance-driven Salesforce emulator.';

// Drafts are shown in the index (clearly tagged) so the template stays visible; they
// are excluded from RSS. Real posts set draft:false.
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title={title} description={description}>
  <h1>Blog</h1>
  <p class="sub">Notes on building a conformance-driven Salesforce emulator.</p>

  {posts.length === 0 && <p>No posts yet.</p>}

  <ul class="post-list">
    {
      posts.map((post) => (
        <li class="post-item">
          <h2>
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
            {post.data.draft && <span class="draft-tag">DRAFT</span>}
          </h2>
          <div class="post-meta">
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          </div>
          <p class="desc">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>
