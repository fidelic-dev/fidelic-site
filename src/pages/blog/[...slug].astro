---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric', month: 'short', day: 'numeric',
    // UTC, because `date: 2026-09-18` in frontmatter IS midnight UTC. Formatting it in
    // the build machine's local zone renders the day before anywhere west of Greenwich,
    // which dated every post on this site one day early.
    timeZone: 'UTC',
  });
---

<Base
  title={`${post.data.title} — Fidelic`}
  description={post.data.description}
  article={{ date: post.data.date, markdown: `/blog/${post.id}.md` }}
>
  <article class="prose">
    <p class="back"><a href="/blog">← Blog</a></p>
    <h1>{post.data.title}</h1>
    <p class="article-meta">
      <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
      {post.data.draft && <span class="draft-tag">DRAFT</span>}
    </p>
    <Content />
  </article>
</Base>

<script>
  // Client-side mermaid: build-time rendering needs a headless browser the deploy can't
  // run, so diagrams render in the visitor's browser. The mermaid bundle is imported
  // lazily and ONLY when a post actually contains a diagram, so pages without diagrams
  // (and every other page) stay zero-JS. Each SVG is rendered off-DOM first, then swapped
  // in — the code block stays as a graceful fallback if a diagram fails.
  const blocks = Array.from(document.querySelectorAll('pre[data-language="mermaid"]'));
  if (blocks.length) {
    const { default: mermaid } = await import('mermaid');
    // DARK THEME, and the palette handed over explicitly rather than left to mermaid's
    // own dark preset — its defaults are tuned for a blue-grey page and land a different
    // surface and a different accent on top of ours. Labels were rendering black on the
    // dark page (1.06:1) under the 'neutral' theme this inherited from the light site.
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'loose',
      theme: 'base',
      themeVariables: {
        darkMode: true,
        background: '#0A0A0B',
        primaryColor: '#131316',        // node fill = the raised surface
        primaryBorderColor: '#2E2E36',
        primaryTextColor: '#EDEDEF',    // 16.4:1 on the node fill
        lineColor: '#6E6E7A',
        secondaryColor: '#17171B',
        tertiaryColor: '#17171B',
        mainBkg: '#131316',
        nodeBorder: '#2E2E36',
        clusterBkg: '#0F0F12',
        clusterBorder: '#26262C',
        titleColor: '#EDEDEF',
        edgeLabelBackground: '#0A0A0B',
        textColor: '#EDEDEF',
        fontFamily: '"Inter", system-ui, sans-serif',
      },
    });
    for (let i = 0; i < blocks.length; i++) {
      const pre = blocks[i];
      const lines = pre.querySelectorAll('code .line');
      const src = lines.length
        ? Array.from(lines).map((l) => l.textContent).join('\n')
        : pre.textContent || '';
      try {
        const { svg } = await mermaid.render('mermaid-' + i, src);
        const figure = document.createElement('figure');
        figure.className = 'mermaid-figure';
        figure.innerHTML = svg;
        pre.replaceWith(figure);
      } catch {
        /* leave the code block in place as a readable fallback */
      }
    }
  }
</script>
