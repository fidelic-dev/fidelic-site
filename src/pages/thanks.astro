---
import Base from '../layouts/Base.astro';
const title = "You're on the list — Fidelic";
const description = 'Thanks for requesting early access to Fidelic. We\'ll be in touch.';
---

<Base title={title} description={description} noindex={true}>
  <article class="prose">
    <p class="back"><a href="/">← Home</a></p>
    <h1>You're on the list.</h1>
    <p>
      Thanks — we got your email. We're onboarding teams a few at a time, so we'll
      reach out when there's a spot. No newsletter, no drip; just the early-access note.
    </p>
    <p>
      In the meantime, the <a href="/docs">docs</a> walk through what Fidelic does and
      how to run it.
    </p>
  </article>
</Base>
